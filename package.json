{
  "name": "authmatrix-inspector",
  "version": "0.1.0",
  "private": true,
  "description": "Static browser app that decodes a Soroban authorization entry, verifies its signature locally, and shows how single-field mutations invalidate it. Paired with authmatrix-core.",
  "license": "MIT",
  "author": "Anas Abubakar",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-pairing.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:pairing": "node scripts/check-pairing.mjs",
    "stamp": "node scripts/stamp-core.mjs"
  },
  "dependencies": {
    "@anasabubakar/authmatrix-core": "file:vendor/anasabubakar-authmatrix-core-0.1.0.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "@types/node": "26.6.4",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
